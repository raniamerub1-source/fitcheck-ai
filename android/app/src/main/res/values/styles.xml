<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme using MaterialComponents / AppCompat Light NoActionBar -->
    <style name="Theme.FitCheckAI" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:statusBarColor">@color/colorPrimary</item>
        <item name="android:navigationBarColor">@color/navigationColor</item>
        <item name="android:windowBackground">@color/backgroundColor</item>
    </style>

    <!-- Splash Theme displayed during cold startup before webview loads -->
    <style name="Theme.FitCheckAI.Splash" parent="Theme.FitCheckAI">
        <item name="android:windowBackground">@drawable/splash</item>
    </style>
</resources>
